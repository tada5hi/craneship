{
    "name": "craneship",
    "version": "4.1.0",
    "type": "module",
    "description": "Build, tag and push docker images, with the tags derived from the git ref.",
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "bin": {
        "craneship": "dist/cli.mjs"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "tsdown",
        "commit": "npx git-cz",
        "lint": "eslint",
        "lint:fix": "npm run lint -- --fix",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "prepare": "husky",
        "start": "node dist/cli.mjs"
    },
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "license": "MIT",
    "keywords": [
        "docker",
        "docker-image",
        "oci",
        "registry",
        "ghcr",
        "publish",
        "push",
        "tag",
        "build",
        "versioning",
        "semver",
        "github-action",
        "cli"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tada5hi/craneship.git"
    },
    "bugs": {
        "url": "https://github.com/tada5hi/craneship/issues"
    },
    "homepage": "https://github.com/tada5hi/craneship#readme",
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.3.2",
        "@tada5hi/eslint-config": "^2.4.0",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/md5": "^2.3.6",
        "@types/node": "^26.6.5",
        "@types/semver": "^7.7.0",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "husky": "^9.1.7",
        "tsdown": "^0.23.1",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "citty": "^0.2.2",
        "consola": "^3.4.2",
        "md5": "^2.3.0",
        "semver": "^7.8.5"
    }
}
